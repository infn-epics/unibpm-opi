  <widget type="xyplot" version="3.0.0">
    <name>EDM xyGraphClass</name>
    <x>10</x>
    <y>60</y>
    <width>600</width>
    <height>470</height>
    <foreground_color>
      <color name="black-14" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="grey-1" red="236" green="236" blue="236">
      </color>
    </background_color>
    <title_font>
      <font family="Liberation Mono" style="REGULAR" size="12.0">
      </font>
    </title_font>
    <show_legend>false</show_legend>
    <rules>
      <rule name="A" prop_id="traces[0].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x1==0x1">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x1==0x0">
          <value>false</value>
        </exp>
        <pv_name>loc://$(BPM)_$(DD)_traces(0)</pv_name>
      </rule>
      <rule name="B" prop_id="traces[1].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x2==0x2">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x2==0x0">
          <value>false</value>
        </exp>
        <pv_name>loc://$(BPM)_$(DD)_traces(0)</pv_name>
      </rule>
      <rule name="C" prop_id="traces[2].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x4==0x4">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x4==0x0">
          <value>false</value>
        </exp>
        <pv_name>loc://$(BPM)_$(DD)_traces(0)</pv_name>
      </rule>
      <rule name="D" prop_id="traces[3].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x8==0x8">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x8==0x0">
          <value>false</value>
        </exp>
        <pv_name>loc://$(BPM)_$(DD)_traces(0)</pv_name>
      </rule>
    </rules>
    <x_axis>
      <title>X</title>
      <autoscale>true</autoscale>
      <log_scale>false</log_scale>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <show_grid>false</show_grid>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
      <visible>true</visible>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>Y</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>100.0</maximum>
        <show_grid>false</show_grid>
        <title_font>
          <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
          </font>
        </title_font>
        <scale_font>
          <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
          </font>
        </scale_font>
        <on_right>false</on_right>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>$(traces[0].y_pv)</name>
        <x_pv></x_pv>
        <y_pv>$(P):$(BPM):adc.A</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
