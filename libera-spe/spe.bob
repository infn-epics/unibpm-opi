  <widget type="stripchart" version="2.1.0">
    <name>EDM xyGraphClass</name>
    <x>10</x>
    <y>60</y>
    <width>600</width>
    <height>560</height>
    <foreground_color>
      <color name="black-14" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="grey-1" red="236" green="236" blue="236">
      </color>
    </background_color>
    <title_font>
      <font family="Liberation Mono" style="REGULAR" size="12.0">
      </font>
    </title_font>
    <show_toolbar>false</show_toolbar>
    <rules>
      <rule name="X" prop_id="traces[0].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x1==0x1">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x1==0x0">
          <value>false</value>
        </exp>
        <pv_name>loc://$(BPM)_$(SS)_traces(0)</pv_name>
      </rule>
      <rule name="Y" prop_id="traces[1].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x2==0x2">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x2==0x0">
          <value>false</value>
        </exp>
        <pv_name>loc://$(BPM)_$(SS)_traces(0)</pv_name>
      </rule>
      <rule name="VA" prop_id="traces[2].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x4==0x4">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x4==0x0">
          <value>false</value>
        </exp>
        <pv_name>loc://$(BPM)_$(SS)_traces(0)</pv_name>
      </rule>
      <rule name="VB" prop_id="traces[3].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x8==0x8">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x8==0x0">
          <value>false</value>
        </exp>
        <pv_name>loc://$(BPM)_$(SS)_traces(0)</pv_name>
      </rule>
      <rule name="VC" prop_id="traces[4].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x10==0x10">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x10==0x0">
          <value>false</value>
        </exp>
        <pv_name>loc://$(BPM)_$(SS)_traces(0)</pv_name>
      </rule>
      <rule name="VD" prop_id="traces[5].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x20==0x20">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x20==0x0">
          <value>false</value>
        </exp>
        <pv_name>loc://$(BPM)_$(SS)_traces(0)</pv_name>
      </rule>
      <rule name="SUM" prop_id="traces[6].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x40==0x40">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x40==0x0">
          <value>false</value>
        </exp>
        <pv_name>loc://$(BPM)_$(SS)_traces(0)</pv_name>
      </rule>
      <rule name="Q" prop_id="traces[7].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x80==0x80">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x80==0x0">
          <value>false</value>
        </exp>
        <pv_name>loc://$(BPM)_$(SS)_traces(0)</pv_name>
      </rule>
    </rules>
    <y_axes>
      <y_axis>
        <title>mm</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>100.0</maximum>
        <show_grid>false</show_grid>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
