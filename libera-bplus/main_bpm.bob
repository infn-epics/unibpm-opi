            <value>DSC compensation not allowed</value>
          </exp>
          <exp bool_exp="(pv0&lt;pv1)&amp;pv0&gt;0">
            <value>DSC compensation allowed</value>
          </exp>
          <pv_name>$(P):$(BPM):dsc:tolerance_curr</pv_name>
          <pv_name>$(P):$(BPM):dsc:tolerance_thr</pv_name>
        </rule>
        <rule name="Rule2" prop_id="background_color" out_exp="false">
          <exp bool_exp="pv0&gt;=pv1">
            <value>
              <color red="249" green="163" blue="102">
              </color>
            </value>
          </exp>
          <exp bool_exp="(pv0&lt;pv1)&amp;pv0&gt;0">
            <value>
              <color red="0" green="255" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>$(P):$(BPM):dsc:tolerance_curr</pv_name>
          <pv_name>$(P):$(BPM):dsc:tolerance_thr</pv_name>
        </rule>
      </rules>
      <border_width>1</border_width>
    </widget>
  </widget>
