  <widget type="label" version="2.0.0">
    <name>Label_21</name>
    <text>enable status</text>
    <x>71</x>
    <y>18</y>
    <width>144</width>
    <height>23</height>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <actions>
    </actions>
    <rules>
      <rule name="Rule" prop_id="text" out_exp="false">
        <exp bool_exp="pv0==0">
          <value>Postmortem disabled</value>
        </exp>
        <exp bool_exp="pv0==1">
          <value>Postmortem enabled</value>
        </exp>
        <pv_name>$(P):$(BPM):pm:capture</pv_name>
      </rule>
      <rule name="Rule2" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>
            <color red="0" green="255" blue="0">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0==0">
          <value>
            <color name="Major" red="255" green="0" blue="0">
            </color>
          </value>
        </exp>
        <pv_name>$(P):$(BPM):pm:capture</pv_name>
      </rule>
    </rules>
    <border_width>1</border_width>
  </widget>
  <widget type="bool_button" version="2.0.0">
