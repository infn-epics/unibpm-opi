  <widget type="label" version="2.0.0">
    <name>Label_25</name>
    <text>Toggle enable to re-arm</text>
    <x>215</x>
    <y>17</y>
    <width>146</width>
    <height>25</height>
    <font>
      <font name="Fine Print" family="Liberation Sans" style="REGULAR" size="12.0">
      </font>
    </font>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <actions>
    </actions>
    <rules>
      <rule name="Rule" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>false</value>
        </exp>
        <exp bool_exp="pv0==0">
          <value>true</value>
        </exp>
        <pv_name>$(P):$(BPM):pm:capture</pv_name>
      </rule>
    </rules>
    <border_color>
      <color red="0" green="128" blue="255">
      </color>
    </border_color>
  </widget>
</display>
