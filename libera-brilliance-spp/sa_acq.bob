  <widget type="stripchart" version="2.1.0">
    <name>EDM xyGraphClass</name>
    <x>10</x>
    <y>70</y>
    <width>600</width>
    <height>500</height>
    <foreground_color>
      <color name="black-14" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <title_font>
      <font family="Liberation Mono" style="REGULAR" size="12.0">
      </font>
    </title_font>
    <show_toolbar>false</show_toolbar>
    <rules>
      <rule name="visibilityX" prop_id="traces[0].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;1 == 1">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;1 == 0">
          <value>false</value>
        </exp>
        <pv_name>loc://sa_traces</pv_name>
      </rule>
      <rule name="visibilityY" prop_id="traces[1].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;2== 2">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;2 == 0">
          <value>false</value>
        </exp>
        <pv_name>loc://sa_traces</pv_name>
      </rule>
      <rule name="visibilityA" prop_id="traces[2].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;4== 4">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;4 == 0">
          <value>false</value>
        </exp>
        <pv_name>loc://sa_traces</pv_name>
      </rule>
      <rule name="visibilityB" prop_id="traces[3].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;8== 8">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;8 == 0">
          <value>false</value>
        </exp>
        <pv_name>loc://sa_traces</pv_name>
      </rule>
      <rule name="visibilityC" prop_id="traces[4].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x10== 0x10">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x10 == 0">
          <value>false</value>
        </exp>
        <pv_name>loc://sa_traces</pv_name>
      </rule>
      <rule name="visibilityD" prop_id="traces[5].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x20== 0x20">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x20== 0">
          <value>false</value>
        </exp>
        <pv_name>loc://sa_traces</pv_name>
      </rule>
      <rule name="visibilitySUM" prop_id="traces[6].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x40== 0x40">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x40== 0">
          <value>false</value>
        </exp>
        <pv_name>loc://sa_traces</pv_name>
      </rule>
      <rule name="visibilityQ" prop_id="traces[7].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x80== 0x80">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x80== 0">
          <value>false</value>
        </exp>
        <pv_name>loc://sa_traces</pv_name>
      </rule>
    </rules>
