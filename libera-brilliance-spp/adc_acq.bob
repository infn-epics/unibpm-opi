  <widget type="xyplot" version="3.0.0">
    <name>EDM xyGraphClass</name>
    <x>20</x>
    <y>80</y>
    <width>600</width>
    <height>500</height>
    <foreground_color>
      <color name="black-14" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <title_font>
      <font family="Liberation Mono" style="REGULAR" size="12.0">
      </font>
    </title_font>
    <show_legend>false</show_legend>
    <rules>
      <rule name="visibility0" prop_id="traces[0].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x1 == 1">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x1 ==0">
          <value>false</value>
        </exp>
        <pv_name>loc://adc_traces</pv_name>
      </rule>
      <rule name="visibility1" prop_id="traces[1].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x2== 2">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x2 ==0">
          <value>false</value>
        </exp>
        <pv_name>loc://adc_traces</pv_name>
      </rule>
      <rule name="visibility2" prop_id="traces[2].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x4== 4">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x4 ==0">
          <value>false</value>
        </exp>
        <pv_name>loc://adc_traces</pv_name>
      </rule>
      <rule name="visibility3" prop_id="traces[3].visible" out_exp="false">
        <exp bool_exp="pvInt0&amp;0x8== 8">
          <value>true</value>
        </exp>
        <exp bool_exp="pvInt0&amp;0x8 ==0">
          <value>false</value>
        </exp>
        <pv_name>loc://adc_traces</pv_name>
      </rule>
    </rules>
